# Copy to .env and fill in. .env is git-ignored. Never commit keys.

# --- Alpaca (paper first!) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper-api.alpaca.markets, false = live. Live additionally requires the promotion gate (see docs/PROMOTION.md).
ALPACA_PAPER=true
# Optional separate live keys (recommended: keep paper and live keys distinct)
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
# Market data feed for stocks: iex (free) or sip (paid)
ALPACA_DATA_FEED=iex

# --- Jev (TypeSafe AI System One) ---
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Hard latency budget for a Jev call in the hot loop (ms). Late answers are discarded -> HOLD.
JEV_LATENCY_BUDGET_MS=400

# --- Safety ---
# Must be set to exactly I_UNDERSTAND_THIS_IS_REAL_MONEY for live order routing.
JEV_LIVE_CONFIRM=

# --- Decision model backend ---
# jev   = hosted TypeSafe Jev (needs TYPESAFE_API_KEY)
# kev   = local Kev server (github.com/jaredpalmer/kev), same /v1/systemone API
# laya  = local Laya server (github.com/NandhaKishorM/laya), same /v1/systemone API
# offline = deterministic heuristic stand-in (NOT a model; for backtests/tests)
DECISION_BACKEND=offline
KEV_BASE_URL=http://127.0.0.1:8009
LAYA_BASE_URL=http://127.0.0.1:8000
# Only needed if you started the local server with an API key (e.g. LAYA_API_KEY)
LOCAL_MODEL_API_KEY=
